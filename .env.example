# Copy this file to .env (for `vercel dev`) or set it in Vercel Project
# Settings -> Environment Variables. Never commit the real value.
#
# Server-side only — read exclusively by api/translate.js. Never expose
# this to the browser: do not prefix it with NEXT_PUBLIC_ or any other
# client-exposed prefix, and never reference it from tosp/js/**.
GOOGLE_CLOUD_TRANSLATE_API_KEY=

# Optional, local development only. When set to the literal string "true",
# api/translate.js returns a deterministic fake Tamil string instead of
# calling Google Cloud Translation, so the frontend<->proxy contract can be
# exercised without a real API key. Never set this in production — leave
# unset (the default) so real requests always go to Google.
TRANSLATE_MOCK_MODE=
